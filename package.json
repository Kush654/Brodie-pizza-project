{
  "name": "pizza-restaurant",
  "version": "1.0.0",
  "description": "A full-stack web application for a pizza restaurant",
  "main": "app.js",
  "type": "module",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "test": "mocha --timeout 10000 test/**/*.test.js",
    "test:unit": "mocha --timeout 10000 test/unit/**/*.test.js",
    "test:integration": "mocha --timeout 10000 test/integration/**/*.test.js",
    "test:api": "mocha --timeout 10000 test/api/**/*.test.js",
    "test:ci": "mocha --timeout 10000 --reporter spec test/unit/**/*.test.js && echo 'Unit tests passed' || exit 1",
    "test:file": "mocha --timeout 10000",
    "test:specific": "mocha --timeout 10000 --grep"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "connect-flash": "^0.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "express-session": "^1.18.1",
    "firebase-admin": "^13.3.0",
    "moment": "^2.30.1",
    "multer": "^1.4.5-lts.2",
    "mysql2": "^3.14.1",
    "nodemailer": "^6.10.1",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "chai": "^5.2.0",
    "chai-http": "^5.1.2",
    "mocha": "^11.2.2",
    "nodemon": "^3.1.10",
    "supertest": "^7.1.0"
  }
}
