# Server Configuration
PORT=3000
NODE_ENV=development

# Session Secret for Express
SESSION_SECRET=your_secret_key_here

# Database Configuration
# Set DB_TYPE to 'mysql' to use MySQL, otherwise SQLite will be used
DB_TYPE=sqlite
# MySQL Configuration (only needed if DB_TYPE is 'mysql')
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=password
DB_NAME=pizza_db

# Email Configuration for Nodemailer
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_password
EMAIL_FROM=Pizza Restaurant <no-reply@example.com>

# Firebase Admin (if using Firebase)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY=your-private-key
FIREBASE_CLIENT_EMAIL=your-client-email

# File Upload Configuration
MAX_FILE_SIZE=5000000 # 5MB in bytes
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp 