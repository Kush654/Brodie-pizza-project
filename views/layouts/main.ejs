<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Pizza Restaurant</title>
  
  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  
  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  
  <!-- Custom CSS -->
  <link rel="stylesheet" href="/css/styles.css">
  
  <% if (typeof extraCSS !== 'undefined') { %>
    <link rel="stylesheet" href="<%= extraCSS %>">
  <% } %>
</head>
<body>
  <!-- Navigation -->
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
      <a class="navbar-brand" href="/">
        <i class="fas fa-pizza-slice"></i> Pizza Restaurant
      </a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav me-auto">
          <li class="nav-item">
            <a class="nav-link" href="/">Home</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/menu">Menu</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/about">About</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/contact">Contact</a>
          </li>
        </ul>
        <ul class="navbar-nav">
          <% if (user) { %>
            <% if (user.role === 'admin' || user.role === 'employee') { %>
              <li class="nav-item">
                <a class="nav-link" href="/employee/dashboard">
                  <i class="fas fa-user-shield"></i> Dashboard
                </a>
              </li>
            <% } %>
            <li class="nav-item dropdown">
              <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                <i class="fas fa-user"></i> <%= user.name %>
              </a>
              <ul class="dropdown-menu dropdown-menu-end">
                <li><a class="dropdown-item" href="/auth/profile">My Profile</a></li>
                <li><a class="dropdown-item" href="/orders">My Orders</a></li>
                <li><hr class="dropdown-divider"></li>
                <li><a class="dropdown-item" href="/auth/logout">Logout</a></li>
              </ul>
            </li>
          <% } else { %>
            <li class="nav-item">
              <a class="nav-link" href="/auth/login">Login</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/auth/register">Register</a>
            </li>
          <% } %>
          <li class="nav-item">
            <a class="nav-link" href="/cart">
              <i class="fas fa-shopping-cart"></i> Cart
              <span class="cart-count" id="cartCount">0</span>
            </a>
          </li>
        </ul>
      </div>
    </div>
  </nav>
  
  <!-- Main Content -->
  <main>
    <%- body %>
  </main>
  
  <!-- Footer -->
  <footer class="bg-dark text-white py-4 mt-5">
    <div class="container">
      <div class="row">
        <div class="col-md-6">
          <h5>Pizza Restaurant</h5>
          <p>The best pizza in town, made with fresh ingredients and love.</p>
          <h5 class="mt-3">Hours</h5>
          <p class="mb-1"><strong>Monday - Thursday:</strong> 11:00 AM - 11:00 AM</p>
          <p class="mb-1"><strong>Friday - Saturday:</strong> 11:00 AM - 11:00 AM</p>
          <p><strong>Sunday:</strong> 12:00 PM - 12:00 PM</p>
        </div>
        <div class="col-md-6">
          <h5>Contact Us</h5>
          <address>
            <p><i class="fas fa-map-marker-alt"></i> 123 Pizza Street, Food City</p>
            <p><i class="fas fa-phone"></i> (555) 123-4567</p>
            <p><i class="fas fa-envelope"></i> info@pizzarestaurant.com</p>
          </address>
        </div>
      </div>
      <hr>
      <div class="row">
        <div class="col-12 text-center">
          <p>&copy; <%= new Date().getFullYear() %> Pizza Restaurant. All rights reserved.</p>
        </div>
      </div>
    </div>
  </footer>
  
  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  
  <!-- Custom JS -->
  <script src="/js/main.js"></script>
  
  <% if (typeof extraJS !== 'undefined') { %>
    <script src="<%= extraJS %>"></script>
  <% } %>
  
  <!-- Cart count update script -->
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      // Function to update cart count
      function updateCartCount() {
        fetch('/cart/api/items')
          .then(response => response.json())
          .then(data => {
            const cartCount = document.getElementById('cartCount');
            if (data && data.items) {
              const itemCount = data.items.length;
              cartCount.textContent = itemCount;
              cartCount.style.display = itemCount > 0 ? 'inline-block' : 'none';
            } else {
              cartCount.textContent = '0';
              cartCount.style.display = 'none';
            }
          })
          .catch(error => console.error('Error fetching cart:', error));
      }
      
      // Update cart count on page load
      updateCartCount();
    });
  </script>
</body>
</html> 