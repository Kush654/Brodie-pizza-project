<%- include('../partials/header', { title: 'Order Management' }) %>

<div class="container py-5">
  <div class="row">
    <!-- Sidebar -->
    <div class="col-md-3 mb-4">
      <div class="list-group shadow-sm">
        <a href="/employee/dashboard" class="list-group-item list-group-item-action">
          <i class="fas fa-tachometer-alt me-2"></i> Dashboard
        </a>
        <a href="/employee/orders" class="list-group-item list-group-item-action active">
          <i class="fas fa-list-alt me-2"></i> Orders
        </a>
        <% if (user.role === 'admin') { %>
          <a href="/admin/menu" class="list-group-item list-group-item-action">
            <i class="fas fa-pizza-slice me-2"></i> Manage Menu
          </a>
          <a href="/admin/users" class="list-group-item list-group-item-action">
            <i class="fas fa-users me-2"></i> Manage Users
          </a>
        <% } %>
        <a href="/" class="list-group-item list-group-item-action">
          <i class="fas fa-home me-2"></i> Back to Site
        </a>
        <a href="/auth/logout" class="list-group-item list-group-item-action text-danger">
          <i class="fas fa-sign-out-alt me-2"></i> Logout
        </a>
      </div>
    </div>
    
    <!-- Orders Content -->
    <div class="col-md-9">
      <div class="card shadow-sm mb-4">
        <div class="card-header bg-light d-flex justify-content-between align-items-center">
          <h4 class="mb-0">Order Management</h4>
        </div>
        <div class="card-body">
          <!-- Order Status Filter Tabs -->
          <ul class="nav nav-tabs mb-4">
            <li class="nav-item">
              <a class="nav-link <%= activeStatus === 'pending' ? 'active' : '' %>" href="/employee/orders?status=pending">
                <span class="badge bg-warning text-dark me-1"><%= orders.filter(o => o.status === 'pending').length %></span>
                Pending
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link <%= activeStatus === 'preparing' ? 'active' : '' %>" href="/employee/orders?status=preparing">
                <span class="badge bg-info text-dark me-1"><%= orders.filter(o => o.status === 'preparing').length %></span>
                Preparing
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link <%= activeStatus === 'ready' ? 'active' : '' %>" href="/employee/orders?status=ready">
                <span class="badge bg-success me-1"><%= orders.filter(o => o.status === 'ready').length %></span>
                Ready
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link <%= activeStatus === 'delivered' ? 'active' : '' %>" href="/employee/orders?status=delivered">
                <span class="badge bg-primary me-1"><%= orders.filter(o => o.status === 'delivered').length %></span>
                Delivered
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link <%= activeStatus === 'cancelled' ? 'active' : '' %>" href="/employee/orders?status=cancelled">
                <span class="badge bg-danger me-1"><%= orders.filter(o => o.status === 'cancelled').length %></span>
                Cancelled
              </a>
            </li>
          </ul>

          <% if (!orders || orders.length === 0) { %>
            <div class="text-center py-5">
              <div class="display-1 text-muted">
                <i class="fas fa-clipboard-list"></i>
              </div>
              <h4 class="mt-3">No <%= activeStatus %> orders</h4>
              <p class="text-muted">There are no orders with this status.</p>
            </div>
          <% } else { %>
            <div class="table-responsive">
              <table class="table table-hover">
                <thead>
                  <tr>
                    <th>Order #</th>
                    <th>Time</th>
                    <th>Customer</th>
                    <th>Total</th>
                    <th>Status</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% orders.forEach(order => { 
                    // Ensure date is parsed properly with local timezone support
                    let orderDate;
                    try {
                      // Try with ISO format if stored that way
                      orderDate = new Date(order.created_at);
                    } catch (e) {
                      // Fallback to default Date parsing
                      orderDate = new Date(order.created_at);
                    }
                    
                    const formattedDate = orderDate.toLocaleString('en-US', { 
                      year: 'numeric', 
                      month: 'short', 
                      day: 'numeric',
                      hour: '2-digit',
                      minute: '2-digit',
                      hour12: true
                    });
                  %>
                    <tr>
                      <td><strong>#<%= order.id %></strong></td>
                      <td><%= formattedDate %></td>
                      <td>
                        <% if (order.user_name) { %>
                          <%= order.user_name %>
                        <% } else { %>
                          Guest
                        <% } %>
                      </td>
                      <td>$<%= parseFloat(order.total_price).toFixed(2) %></td>
                      <td>
                        <span class="badge 
                          <% if (order.status === 'pending') { %>bg-warning text-dark<% } %>
                          <% if (order.status === 'preparing') { %>bg-info text-dark<% } %>
                          <% if (order.status === 'ready') { %>bg-success<% } %>
                          <% if (order.status === 'delivered') { %>bg-primary<% } %>
                          <% if (order.status === 'cancelled') { %>bg-danger<% } %>
                        ">
                          <%= order.status.charAt(0).toUpperCase() + order.status.slice(1) %>
                        </span>
                      </td>
                      <td>
                        <div class="btn-group">
                          <a href="/orders/<%= order.id %>" class="btn btn-sm btn-outline-secondary">
                            <i class="fas fa-eye"></i>
                          </a>
                          <% if (order.status === 'pending') { %>
                            <form action="/employee/orders/<%= order.id %>/status" method="POST" class="d-inline">
                              <input type="hidden" name="status" value="preparing">
                              <button type="submit" class="btn btn-sm btn-outline-info">
                                <i class="fas fa-utensils"></i> Start
                              </button>
                            </form>
                          <% } else if (order.status === 'preparing') { %>
                            <form action="/employee/orders/<%= order.id %>/status" method="POST" class="d-inline">
                              <input type="hidden" name="status" value="ready">
                              <button type="submit" class="btn btn-sm btn-outline-success">
                                <i class="fas fa-check"></i> Ready
                              </button>
                            </form>
                          <% } else if (order.status === 'ready') { %>
                            <form action="/employee/orders/<%= order.id %>/status" method="POST" class="d-inline">
                              <input type="hidden" name="status" value="delivered">
                              <button type="submit" class="btn btn-sm btn-outline-primary">
                                <i class="fas fa-truck"></i> Delivered
                              </button>
                            </form>
                          <% } %>
                          
                          <% if (order.status !== 'cancelled' && order.status !== 'delivered') { %>
                            <form action="/employee/orders/<%= order.id %>/status" method="POST" class="d-inline">
                              <input type="hidden" name="status" value="cancelled">
                              <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Are you sure you want to cancel this order?');">
                                <i class="fas fa-times"></i> Cancel
                              </button>
                            </form>
                          <% } %>
                        </div>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %> 