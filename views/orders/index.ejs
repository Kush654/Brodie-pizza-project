<%- include('../partials/header', { title: 'My Orders' }) %>

<div class="container py-5">
  <div class="row">
    <!-- Sidebar -->
    <div class="col-md-4 mb-4">
      <div class="list-group shadow-sm">
        <a href="/auth/profile" class="list-group-item list-group-item-action">
          <i class="fas fa-user me-2"></i> My Profile
        </a>
        <a href="/orders" class="list-group-item list-group-item-action active">
          <i class="fas fa-shopping-bag me-2"></i> My Orders
        </a>
        <a href="/auth/change-password" class="list-group-item list-group-item-action">
          <i class="fas fa-key me-2"></i> Change Password
        </a>
        <a href="/auth/logout" class="list-group-item list-group-item-action text-danger">
          <i class="fas fa-sign-out-alt me-2"></i> Logout
        </a>
      </div>
    </div>
    
    <!-- Orders Content -->
    <div class="col-md-8">
      <div class="card shadow-sm">
        <div class="card-header bg-light d-flex justify-content-between align-items-center">
          <h4 class="mb-0">My Orders</h4>
          <a href="/menu" class="btn btn-primary btn-sm">
            <i class="fas fa-pizza-slice me-1"></i> Order More
          </a>
        </div>
        <div class="card-body">
          <% if (!orders || orders.length === 0) { %>
            <div class="text-center py-5">
              <div class="display-1 text-muted">
                <i class="fas fa-shopping-bag"></i>
              </div>
              <h4 class="mt-3">No Orders Yet</h4>
              <p class="text-muted">You haven't placed any orders yet.</p>
              <a href="/menu" class="btn btn-primary mt-3">
                <i class="fas fa-pizza-slice me-2"></i> Order Now
              </a>
            </div>
          <% } else { %>
            <div class="table-responsive">
              <table class="table table-hover">
                <thead>
                  <tr>
                    <th>Order #</th>
                    <th>Date</th>
                    <th>Total</th>
                    <th>Status</th>
                    <th>Action</th>
                  </tr>
                </thead>
                <tbody>
                  <% orders.forEach(order => { 
                    let statusBadgeClass = 'bg-secondary';
                    if (order.status === 'pending') statusBadgeClass = 'bg-warning text-dark';
                    if (order.status === 'preparing') statusBadgeClass = 'bg-info text-dark';
                    if (order.status === 'ready') statusBadgeClass = 'bg-success';
                    if (order.status === 'delivered') statusBadgeClass = 'bg-primary';
                    if (order.status === 'cancelled') statusBadgeClass = 'bg-danger';
                    
                    const orderDate = new Date(order.created_at);
                    const formattedDate = orderDate.toLocaleDateString('en-US', { 
                      year: 'numeric', 
                      month: 'short', 
                      day: 'numeric',
                      hour: '2-digit',
                      minute: '2-digit'
                    });
                  %>
                    <tr>
                      <td><strong><%= order.id %></strong></td>
                      <td><%= formattedDate %></td>
                      <td>$<%= parseFloat(order.total_price).toFixed(2) %></td>
                      <td>
                        <span class="badge <%= statusBadgeClass %>">
                          <%= order.status.charAt(0).toUpperCase() + order.status.slice(1) %>
                        </span>
                      </td>
                      <td>
                        <a href="/orders/<%= order.id %>" class="btn btn-sm btn-outline-primary">
                          <i class="fas fa-eye"></i> View
                        </a>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %> 