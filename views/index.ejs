<%- include('partials/header', { title: title }) %>

<!-- Hero Section -->
<section class="hero">
  <div class="container">
    <div class="hero-content">
      <h1>Imaginary Pizza, Delivered to Your Door</h1>
      <p>A fake pizza restaurant</p>
      <a href="/menu" class="btn btn-primary btn-lg">Order Now</a>
    </div>
  </div>
</section>

<!-- Featured Items -->
<section class="container my-5">
  <div class="row mb-4">
    <div class="col-12 text-center">
      <h2>Our Featured Menu Items</h2>
      <p class="lead text-muted">Try some of our hypothetically popular dishes</p>
    </div>
  </div>
  
  <div class="row">
    <% if (featuredItems && featuredItems.length > 0) { %>
      <% featuredItems.forEach(function(item) { %>
        <div class="col-md-6 col-lg-3 mb-4">
          <div class="card h-100">
            <img src="<%= item.image_url || '/images/default-pizza.jpg' %>" class="card-img-top" alt="<%= item.name %>">
            <div class="card-body">
              <h5 class="card-title"><%= item.name %></h5>
              <p class="card-text"><%= item.description %></p>
              <p class="price">$<%= item.price.toFixed(2) %></p>
              <a href="/menu/item/<%= item.id %>" class="btn btn-outline-primary">View Details</a>
              <button class="btn btn-primary add-to-cart-btn" data-item-id="<%= item.id %>">
                <i class="fas fa-cart-plus"></i> Add to Cart
              </button>
            </div>
          </div>
        </div>
      <% }); %>
    <% } else { %>
      <div class="col-12 text-center">
        <p>No featured items available right now. Check back soon!</p>
      </div>
    <% } %>
  </div>
  
  <div class="row mt-4">
    <div class="col-12 text-center">
      <a href="/menu" class="btn btn-lg btn-outline-primary">View Full Menu</a>
    </div>
  </div>
</section>

<!-- About Section -->
<section class="bg-light py-5 my-5">
  <div class="container">
    <div class="row align-items-center">
      <div class="col-lg-6 mb-4 mb-lg-0">
        <img src="/images/about-pizza.jpg" alt="About Our Pizza" class="img-fluid rounded shadow">
      </div>
      <div class="col-lg-6">
        <h2>About Our Pizza</h2>
        <p class="lead">This is a fake pizza restaurant.</p>
        <p>This is Brodie Schurbon's final project.</p>
        <a href="/about" class="btn btn-outline-primary">Learn More About Us</a>
      </div>
    </div>
  </div>
</section>

<!-- Services -->
<section class="container my-5">
  <div class="row mb-4">
    <div class="col-12 text-center">
      <h2>Our Services</h2>
      <p class="lead text-muted">Why choose Pizza Restaurant?</p>
    </div>
  </div>
  
  <div class="row">
    <div class="col-md-4 mb-4">
      <div class="card h-100 text-center p-4">
        <div class="card-body">
          <i class="fas fa-shipping-fast text-primary mb-3" style="font-size: 3rem;"></i>
          <h4 class="card-title">Fast Delivery</h4>
          <p class="card-text">If you consider 30 minutes to an hour fast.</p>
        </div>
      </div>
    </div>
    
    <div class="col-md-4 mb-4">
      <div class="card h-100 text-center p-4">
        <div class="card-body">
          <i class="fas fa-utensils text-primary mb-3" style="font-size: 3rem;"></i>
          <h4 class="card-title">Fresh Ingredients</h4>
          <p class="card-text">Only been frozen for 6 months.</p>
        </div>
      </div>
    </div>
    
    <div class="col-md-4 mb-4">
      <div class="card h-100 text-center p-4">
        <div class="card-body">
          <i class="fas fa-user-friends text-primary mb-3" style="font-size: 3rem;"></i>
          <h4 class="card-title">Excellent Service</h4>
          <p class="card-text">Our call center staff pretend to be deaf whenever you try and speak to them.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Call to Action -->
<section class="bg-primary text-white py-5 my-5">
  <div class="container">
    <div class="row justify-content-center text-center">
      <div class="col-md-8">
        <h2>Ready to order?</h2>
        <p class="lead">Our menu has something for everyone. Order now and enjoy!</p>
        <a href="/menu" class="btn btn-lg btn-light">Order Now</a>
        <a href="/contact" class="btn btn-lg btn-outline-light ms-3">Contact Us</a>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %> 